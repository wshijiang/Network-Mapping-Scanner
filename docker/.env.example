SCANNER_IMAGE=ghcr.io/wshijiang/network-mapping-scanner:vREPLACE_WITH_APPROVED_VERSION
NM__SCANNER__C_SERVER=server.example.com
NM__SCANNER__C_PORT=9999
NM__SCANNER__RATE=1000
NM__SCANNER__VERIFY_TLS=true
# First deployment: paste the ID and one-time token from the server console.
# After success the identity lives in scanner-data. Same credentials do not
# register again; a new one-time token triggers re-registration on recreation.
NM__REGISTRATION__SCANNER_ID=
NM__REGISTRATION__TOKEN=
NM__NUCLEI__ENABLED=false
NM__NUCLEI__UPDATE_TEMPLATES=false
NM__NUCLEI__TEMPLATE_UPDATE_TIMEOUT_SECONDS=300
# Arrays use JSON, e.g. NM__DNS__RECORD_TYPES=["A","AAAA"]
